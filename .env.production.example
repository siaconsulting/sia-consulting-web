# Copy to the server as /srv/apps/sia-consulting-web/shared/.env.
# Replace every angle-bracket placeholder out-of-band. Never commit the real file.

# App and database (PostgreSQL must listen only on localhost/private socket).
DATABASE_URL=postgresql://sia_app:<DB_PASSWORD>@127.0.0.1:5432/sia_consulting
PAYLOAD_SECRET=<GENERATE_A_UNIQUE_RANDOM_SECRET>
NEXT_PUBLIC_SERVER_URL=https://siaconsulting.fr

# Independently generated server-only secrets.
REVALIDATION_SECRET=<GENERATE_A_UNIQUE_RANDOM_SECRET>
PREVIEW_SECRET=<GENERATE_A_UNIQUE_RANDOM_SECRET>
SUBMISSION_RATE_LIMIT_SECRET=<GENERATE_A_UNIQUE_RANDOM_SECRET>

# Nginx must overwrite this header; the app port must not be reachable externally.
SUBMISSION_TRUSTED_PROXY_IP_HEADER=x-real-ip

# Decide from approved legal wording before enabling public forms.
SUBMISSION_PRIVACY_CONSENT_REQUIRED=<true-or-false>
# SUBMISSION_PRIVACY_NOTICE_VERSION=<APPROVED_NOTICE_VERSION>
# SUBMISSION_PRIVACY_NOTICE_TEXT=<APPROVED_NOTICE_TEXT>

# Optional until public forms are enabled. Keep blank/commented to run the site without SMTP.
# Uncomment and replace every value only before forms are opened.
# SMTP_HOST=<SMTP_HOST>
# SMTP_PORT=<SMTP_PORT>
# SMTP_SECURE=<true-or-false>
# SMTP_USER=<SMTP_USERNAME_OR_EMPTY>
# SMTP_PASS=<SMTP_PASSWORD_OR_EMPTY>
# SMTP_FROM_ADDRESS=<VERIFIED_SENDER_ADDRESS>
# SMTP_FROM_NAME=<APPROVED_SENDER_NAME>
# SUBMISSION_NOTIFICATION_TO=<INTERNAL_NOTIFICATION_RECIPIENT>

# Optional when jobs are only run by the local systemd worker. Needed for authenticated
# remote Payload job triggering, which is not the recommended VPS worker path.
# CRON_SECRET=<GENERATE_IF_REMOTE_JOB_TRIGGERING_IS_ENABLED>
